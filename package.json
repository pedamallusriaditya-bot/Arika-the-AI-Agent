{
  "name": "arika",
  "displayName": "Arika",
  "description": "Production-grade AI coding assistant extension for VS Code",
  "version": "0.0.1",
  "publisher": "arika-dev",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "AI",
    "Other",
    "Programming Languages"
  ],
  "main": "./out/extension.js",
  "activationEvents": [],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "arika-sidebar-container",
          "title": "Arika",
          "icon": "$(comment-discussion)"
        }
      ]
    },
    "views": {
      "arika-sidebar-container": [
        {
          "type": "webview",
          "id": "arika.sidebarView",
          "name": "Arika",
          "icon": "$(comment-discussion)"
        }
      ]
    },
    "commands": [
      {
        "command": "arika.openChat",
        "title": "Arika: Open Chat Panel",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "arika.explainSelection",
        "title": "Arika: Explain Selection",
        "icon": "$(lightbulb)"
      },
      {
        "command": "arika.explainCurrentFile",
        "title": "Arika: Explain Current File",
        "icon": "$(file-code)"
      },
      {
        "command": "arika.focusSidebar",
        "title": "Arika: Focus Sidebar Chat",
        "icon": "$(comment-discussion)"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "arika.explainCurrentFile",
          "group": "arika@1"
        },
        {
          "command": "arika.explainSelection",
          "group": "arika@2",
          "when": "editorHasSelection"
        },
        {
          "command": "arika.openChat",
          "group": "arika@3"
        }
      ],
      "commandPalette": [
        {
          "command": "arika.openChat"
        },
        {
          "command": "arika.explainSelection"
        },
        {
          "command": "arika.explainCurrentFile"
        },
        {
          "command": "arika.focusSidebar"
        }
      ]
    },
    "keybindings": [
      {
        "command": "arika.explainSelection",
        "key": "ctrl+alt+e",
        "mac": "cmd+alt+e",
        "when": "editorHasSelection"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.6",
    "@types/node": "20.x",
    "@types/vscode": "^1.90.0",
    "@vscode/test-cli": "^0.0.9",
    "@vscode/test-electron": "^2.4.0",
    "typescript": "^5.4.5"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "dotenv": "^17.4.2",
    "openai": "^7.4.0"
  }
}
